{
  "schema": 1,
  "connectors": [
    {
      "id": "codex",
      "name": "OpenAI Codex CLI",
      "level": "tested",
      "format": "toml",
      "config_path": "~/.codex/config.toml",
      "source_url": "https://learn.chatgpt.com/docs/extend/mcp?surface=cli"
    },
    {
      "id": "claude-code",
      "name": "Claude Code",
      "level": "tested",
      "format": "json",
      "shape": "mcpServers",
      "config_path": ".mcp.json",
      "source_url": "https://code.claude.com/docs/en/mcp",
      "note": "Writes project .mcp.json (never rewrites live ~/.claude.json); for user scope run: claude mcp add --scope user coco -- <cmd>"
    },
    {
      "id": "claude-desktop",
      "name": "Claude Desktop",
      "level": "config",
      "format": "json",
      "shape": "mcpServers",
      "config_path": "~/Library/Application Support/Claude/claude_desktop_config.json",
      "source_url": "https://claude.com/docs/connectors/building"
    },
    {
      "id": "cursor",
      "name": "Cursor",
      "level": "config",
      "format": "json",
      "shape": "mcpServers",
